# Copy this file to `.env` and fill it in. `.env` is gitignored and must never be committed.

# REQUIRED for anything that talks to SEC EDGAR (fundamentals, insider filings, 8-K index).
# SEC mandates a descriptive User-Agent with a real contact address and blocks requests without
# one — and a block looks exactly like "this company has no filings", so it fails loudly instead.
SEC_CONTACT_EMAIL=you@example.com

# OPTIONAL. Enables the AI daily brief and the filing-text extraction pilot.
# NOTE: the Anthropic API is billed SEPARATELY from a Claude subscription — Claude.ai usage
# credits do NOT apply to it. Get a key at console.anthropic.com. Everything else in this
# project runs without one.
ANTHROPIC_API_KEY=
